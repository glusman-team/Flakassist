{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@howaboua/opencode-planning-toolkit@latest",
    "@tarquinen/opencode-dcp@latest",
    "opencode-mem",
    "@skyeav/tablassist"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "@playwright/mcp@latest"]
    }
  },
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (8080)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "mradermacher/MiniMax-M2.7-REAP-172B-A10B-BF16-i1-GGUF:IQ2_S": {
          "name": "MiniMax M2.7 REAP 172B A10B IQ2_S",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "inclusionai/ring-2.6-1t:free": {
          "name": "Ring 2.6 1T (free)",
          "tool_call": true,
          "reasoning": true
        }
      }
    }
  }
}
