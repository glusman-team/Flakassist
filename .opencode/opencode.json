{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@howaboua/opencode-planning-toolkit@latest",
    "@tarquinen/opencode-dcp@latest",
    "opencode-mem",
    "@skyeav/tablassist"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "@playwright/mcp@latest"]
    }
  },
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (8080)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "llama-server -hf unsloth/Qwen3.6-35B-A3B-MTP-GGUF:UD-Q8_K_XL": {
          "name": "Qwen3.6 35B A3B MTP Q8_K_XL",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "baidu/cobuddy:free": {
          "name": "Baidu CoBuddy (free)",
          "tool_call": true,
          "reasoning": true
        }
      }
    }
  }
}
